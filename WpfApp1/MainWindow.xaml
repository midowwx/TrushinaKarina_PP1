<Window x:Class="WpfApp10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp10"
        mc:Ignorable="d"
        Title="Менеджер проектов" Height="520" Width="877" WindowStartupLocation="CenterScreen">
    <Grid Margin="10,10,10,10">
        <Button Content="Добавить проект" HorizontalAlignment="Right" Margin="0,0,160,0" VerticalAlignment="Top" Height="45" Width="153" Click="cmNewP"/>
        <Button Content="Удалить проект" HorizontalAlignment="Right" VerticalAlignment="Top" Height="45" Width="156" Click="cmDeletProject"/>
        <Grid Margin="0,0,333,0">
            <DataGrid x:Name="grid" ItemsSource="{Binding Projects}" AutoGenerateColumns="False" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding NameUsluga}"/>
                    <DataGridTextColumn Header="Заказчик" Binding="{Binding ClientName}"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBox x:Name="strings" HorizontalAlignment="Right" Margin="0,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="22" TextChanged="strings_TextChanged" Visibility="Hidden"/>
        <Label x:Name="labelStrings" Content="Введите данные столбцов: Услуга, Заказчик, Статус" HorizontalAlignment="Right" Margin="0,72,0,0" VerticalAlignment="Top" Width="313" Visibility="Hidden"/>
        <Button x:Name="butonStrings" Content="Добавить" HorizontalAlignment="Right" Margin="0,130,0,0" VerticalAlignment="Top" Height="30" Width="115" Visibility="Hidden" Click="cmAdd"/>
        <TextBox x:Name="stringa" HorizontalAlignment="Right" Margin="0,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="22" TextChanged="stringa_TextChanged" Visibility="Hidden"/>
        <Label x:Name="labelStringa" Content="Введите ID записи которую хотите удалить" HorizontalAlignment="Right" Margin="0,72,0,0" VerticalAlignment="Top" Width="313" Visibility="Hidden"/>
        <Button x:Name="butonStringa" Content="Удалить" HorizontalAlignment="Right" Margin="0,130,0,0" VerticalAlignment="Top" Height="30" Width="115" Click="cmDelet" Visibility="Hidden"/>
        <Button x:Name="otmena" Content="Отмена" HorizontalAlignment="Right" Margin="0,165,-1,0" VerticalAlignment="Top" Width="116" Height="30" Visibility="Hidden" Click="cmOtmena"/>
        <Button Content="Сохранить" HorizontalAlignment="Right" Margin="0,0,-1,0" VerticalAlignment="Bottom" Height="50" Width="154" Click="cmSave"/>
    </Grid>
</Window>
